# Dev-environment placeholders. Copy to infra/dev/.env and replace with real dev-only
# secrets (never local dev passwords, never production credentials).
# Never commit infra/dev/.env.
POSTGRES_SUPERUSER_PASSWORD=change_me_dev_only
AUTH_DB_PASSWORD=change_me_dev_only
BUILDING_DB_PASSWORD=change_me_dev_only
SUBSCRIPTION_DB_PASSWORD=change_me_dev_only
BACK_OFFICE_DB_PASSWORD=change_me_dev_only
# Verification-document object storage (MinIO, D-28). building-service uses these as its S3 keys.
MINIO_ROOT_USER=change_me_dev_only
MINIO_ROOT_PASSWORD=change_me_dev_only_min8
DOCUMENTS_S3_BUCKET=building-documents
