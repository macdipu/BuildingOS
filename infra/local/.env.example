# Local-only placeholders. Copy to infra/local/.env and replace before `docker compose up`.
# Never commit infra/local/.env or reuse these values outside a local dev machine.
POSTGRES_SUPERUSER_PASSWORD=change_me_local_only
AUTH_DB_PASSWORD=change_me_local_only
BUILDING_DB_PASSWORD=change_me_local_only
SUBSCRIPTION_DB_PASSWORD=change_me_local_only
BACK_OFFICE_DB_PASSWORD=change_me_local_only
MINIO_ROOT_USER=change_me_local_only
MINIO_ROOT_PASSWORD=change_me_local_only_min8
DOCUMENTS_S3_BUCKET=building-documents
# D-38 back-office-service client secret for auth-service service tokens (>= 32 chars; same value
# is read by auth-service and back-office-service).
BACKOFFICE_SERVICE_CLIENT_SECRET=change_me_local_only_at_least_32_characters
